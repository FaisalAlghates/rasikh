# Local development uses the Firebase Emulator Suite and a demo project: no values needed.
# To point at a real Firebase project, set NEXT_PUBLIC_USE_EMULATORS=false and fill these in.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mapbox public token (restrict it by URL in the Mapbox dashboard). Without it the portfolio shows a flat schematic.
NEXT_PUBLIC_MAPBOX_TOKEN=
