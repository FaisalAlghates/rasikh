rules_version = '2';

// Rasikh Firestore rules — deny by default.
// Membership and roles live in custom claims set only by Cloud Functions:
//   request.auth.token.orgs = { "<orgId>": ["owner", "tenant", ...] }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMember(orgId) {
      return signedIn() && request.auth.token.get('orgs', {}).keys().hasAny([orgId]);
    }
    function rolesIn(orgId) {
      return request.auth.token.orgs[orgId];
    }
    function isStaff(orgId) {
      return hasAnyRole(orgId, ['owner', 'manager', 'admin']);
    }
    function hasAnyRole(orgId, allowed) {
      return isMember(orgId) && rolesIn(orgId).hasAny(allowed);
    }

    // Personal profile: owner only, and only whitelisted fields (no roles here).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'locale', 'digits', 'theme'])
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80);
      allow delete: if false;
    }

    // Links from a person to the buildings they own a unit in; written only by Functions.
    match /users/{uid}/memberships/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Organization root and member list: readable by members, written only by Functions.
    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(orgId);
        allow write: if false;
      }

      // Audit log: admins and owners may read; only Functions write.
      match /audit/{id} {
        allow read: if hasAnyRole(orgId, ['owner', 'admin']);
        allow write: if false;
      }

      // Example collection used to prove the pattern; later phases add their own blocks.
      match /properties/{propertyId} {
        allow read: if hasAnyRole(orgId, ['owner', 'manager', 'admin', 'broker']);
        allow create, update: if hasAnyRole(orgId, ['owner', 'manager', 'admin']);
        allow delete: if hasAnyRole(orgId, ['owner', 'admin']);
      }

      // ---- Phase 4: owner operations -------------------------------------------------------
      match /units/{unitId} {
        allow read: if hasAnyRole(orgId, ['owner', 'manager', 'admin', 'broker']);
        allow create, update, delete: if isStaff(orgId);
      }

      // Tenants read only their own lease and payments (matched on tenantUid).
      match /leases/{leaseId} {
        allow read: if isStaff(orgId)
          || (isMember(orgId) && resource.data.get('tenantUid', '') == request.auth.uid);
        allow create, update, delete: if isStaff(orgId);
      }

      match /payments/{paymentId} {
        allow read: if isStaff(orgId)
          || (isMember(orgId) && resource.data.get('tenantUid', '') == request.auth.uid);
        allow create, delete: if isStaff(orgId);
        // Staff mark payments paid; a tenant may only attach a receipt to their own payment.
        allow update: if isStaff(orgId)
          || (isMember(orgId) && resource.data.get('tenantUid', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptPath']));
      }

      match /expenses/{expenseId} {
        allow read, write: if isStaff(orgId);
      }

      match /documents/{docId} {
        allow read: if hasAnyRole(orgId, ['owner', 'manager', 'admin', 'broker']);
        allow create, update, delete: if isStaff(orgId);
      }

      // ---- Phase 5: inspections ------------------------------------------------------------
      // A draft is edited by staff only. Signing goes through the signInspection function, which
      // writes the signatures and the status; after the first signature nothing under it can change.
      function insp(orgId, iid) {
        return get(/databases/$(database)/documents/orgs/$(orgId)/inspections/$(iid));
      }
      function isDraft(orgId, iid) {
        return insp(orgId, iid).data.status == 'draft';
      }
      function canReadInspection(orgId, iid) {
        return isStaff(orgId)
          || (isMember(orgId) && insp(orgId, iid).data.get('tenantUid', '') == request.auth.uid);
      }

      match /inspections/{inspectionId} {
        allow read: if isStaff(orgId)
          || (isMember(orgId) && resource.data.get('tenantUid', '') == request.auth.uid);

        allow create: if isStaff(orgId)
          && request.resource.data.keys().hasOnly(['unitId', 'propertyId', 'leaseId', 'tenantUid',
               'kind', 'rooms', 'moveInId', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasAll(['unitId', 'propertyId', 'leaseId', 'kind', 'rooms',
               'status', 'createdBy', 'createdAt'])
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in ['move_in', 'move_out']
          && request.resource.data.rooms is list
          && request.resource.data.rooms.size() > 0 && request.resource.data.rooms.size() <= 60
          && exists(/databases/$(database)/documents/orgs/$(orgId)/leases/$(request.resource.data.leaseId))
          && request.resource.data.get('tenantUid', '') ==
             get(/databases/$(database)/documents/orgs/$(orgId)/leases/$(request.resource.data.leaseId)).data.get('tenantUid', '')
          && request.resource.data.unitId ==
             get(/databases/$(database)/documents/orgs/$(orgId)/leases/$(request.resource.data.leaseId)).data.unitId;

        // The tenant may leave a comment until the inspection is sealed. Nothing else is editable.
        allow update: if isMember(orgId)
          && resource.data.get('tenantUid', '') == request.auth.uid
          && resource.data.status != 'sealed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenantComment'])
          && request.resource.data.tenantComment is string
          && request.resource.data.tenantComment.size() <= 500;

        allow delete: if isStaff(orgId) && resource.data.status == 'draft';

        match /items/{itemId} {
          allow read: if canReadInspection(orgId, inspectionId);
          allow create, update: if isStaff(orgId)
            && isDraft(orgId, inspectionId)
            && request.resource.data.keys().hasOnly(['room', 'item', 'condition', 'note', 'assessment', 'costSar'])
            && request.resource.data.keys().hasAll(['room', 'item', 'condition', 'note'])
            && itemId == request.resource.data.room + '__' + request.resource.data.item
            && request.resource.data.room in insp(orgId, inspectionId).data.rooms
            && request.resource.data.condition in ['good', 'fair', 'poor', 'damaged']
            && request.resource.data.note is string && request.resource.data.note.size() <= 300
            && (!('assessment' in request.resource.data)
                || (request.resource.data.assessment in ['wear', 'damage']
                    && insp(orgId, inspectionId).data.kind == 'move_out'))
            && (!('costSar' in request.resource.data)
                || (request.resource.data.costSar is number && request.resource.data.costSar >= 0
                    && insp(orgId, inspectionId).data.kind == 'move_out'));
          allow delete: if isStaff(orgId) && isDraft(orgId, inspectionId);
        }

        // Evidence metadata is create-only. The file itself is write-once in Storage.
        match /media/{mediaId} {
          allow read: if canReadInspection(orgId, inspectionId);
          allow create: if isStaff(orgId)
            && isDraft(orgId, inspectionId)
            && request.resource.data.keys().hasOnly(['room', 'item', 'path', 'sha256', 'size', 'contentType',
                 'capturedAt', 'gps', 'device', 'source', 'uploadedBy', 'createdAt'])
            && request.resource.data.keys().hasAll(['room', 'path', 'sha256', 'size', 'contentType',
                 'capturedAt', 'device', 'source', 'uploadedBy', 'createdAt'])
            && request.resource.data.source == 'in_app_camera'
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.room in insp(orgId, inspectionId).data.rooms
            && request.resource.data.sha256 is string
            && request.resource.data.sha256.matches('^[a-f0-9]{64}$')
            && request.resource.data.path.matches('^orgs/' + orgId + '/inspections/' + inspectionId + '/[^/]+$')
            && request.resource.data.size is int && request.resource.data.size > 0;
          allow delete: if isStaff(orgId) && isDraft(orgId, inspectionId);
          allow update: if false;
        }
      }

      // ---- Phase 6: maintenance tickets ----------------------------------------------------
      // Created and moved along only by the createTicket / ticketAction functions.
      match /tickets/{ticketId} {
        allow read: if isStaff(orgId)
          || (isMember(orgId) && resource.data.get('tenantUid', '') == request.auth.uid)
          || (isMember(orgId) && resource.data.get('vendorUid', '') == request.auth.uid);
        allow write: if false;
      }
      // ---- Phase 6: buildings and owners associations -------------------------------------
      // The association's own records, kept by the organization's staff. The ledger is append-only:
      // every shared expense needs a receipt, and expenses, contributions and ballots can never be edited.
      match /buildings/{buildingId} {
        // A unit owner linked by the invite function (owners/{uid}) reads the whole ledger of that building.
        function isUnitOwner() {
          return isMember(orgId)
            && exists(/databases/$(database)/documents/orgs/$(orgId)/buildings/$(buildingId)/owners/$(request.auth.uid));
        }
        function readsBuilding() {
          return isStaff(orgId) || isUnitOwner();
        }

        allow read: if readsBuilding();
        allow create, update: if isStaff(orgId);
        allow delete: if false;

        // Written only by the inviteBuildingMember function.
        match /owners/{uid} {
          allow read: if isStaff(orgId) || (signedIn() && request.auth.uid == uid);
          allow write: if false;
        }

        match /members/{memberId} {
          allow read: if readsBuilding();
          allow delete: if isStaff(orgId);
          allow create, update: if isStaff(orgId)
            && request.resource.data.keys().hasOnly(['name', 'unitLabel', 'shareBp'])
            && request.resource.data.shareBp is int
            && request.resource.data.shareBp > 0 && request.resource.data.shareBp <= 10000;
        }
        match /expenses/{expenseId} {
          allow read: if readsBuilding();
          allow create: if isStaff(orgId)
            && request.resource.data.keys().hasOnly(['title', 'amount', 'date', 'receiptPath', 'createdAt'])
            && request.resource.data.amount is number && request.resource.data.amount > 0
            && request.resource.data.receiptPath is string && request.resource.data.receiptPath.size() > 0
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
        match /contributions/{contributionId} {
          allow read: if readsBuilding();
          allow create: if isStaff(orgId)
            && request.resource.data.keys().hasOnly(['memberId', 'amount', 'date', 'createdAt'])
            && request.resource.data.amount is number && request.resource.data.amount > 0
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
        match /quotes/{quoteId} {
          allow read: if readsBuilding();
          allow create, delete: if isStaff(orgId);
          allow update: if false;
        }
        match /votes/{voteId} {
          allow read: if readsBuilding();
          allow create: if isStaff(orgId)
            && request.resource.data.rule in ['majority', 'three_quarters']
            && request.resource.data.keys().hasOnly(['title', 'rule', 'closed', 'createdAt']);
          allow update: if isStaff(orgId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed']);
          allow delete: if false;
          match /ballots/{memberId} {
            function voteOpen() {
              return !get(/databases/$(database)/documents/orgs/$(orgId)/buildings/$(buildingId)/votes/$(voteId)).data.closed;
            }
            allow read: if readsBuilding();
            // Staff record a ballot for any unit; a unit owner casts only their own. One per unit, never edited.
            allow create: if request.resource.data.choice in ['yes', 'no', 'abstain']
              && request.resource.data.keys().hasOnly(['choice'])
              && voteOpen()
              && (isStaff(orgId)
                  || (isUnitOwner()
                      && get(/databases/$(database)/documents/orgs/$(orgId)/buildings/$(buildingId)/owners/$(request.auth.uid)).data.memberId == memberId));
            allow update, delete: if false;
          }
        }
      }

      // ---- Phase 7: broker CRM -------------------------------------------------------------
      // A broker's leads, viewings, contracts and log are private to that broker (brokerUid); owners and
      // admins of the organization can read them. The activity log is create-only and time-stamped by the server.
      function isBroker() {
        return hasAnyRole(orgId, ['broker']);
      }
      function canSeeBrokerData() {
        return hasAnyRole(orgId, ['owner', 'admin']);
      }
      function leadOf(leadId) {
        return get(/databases/$(database)/documents/orgs/$(orgId)/leads/$(leadId));
      }
      function leadRank() {
        return {'new': 0, 'contacted': 1, 'viewing': 2, 'negotiating': 3, 'won': 4, 'lost': 5};
      }

      match /brokers/{uid} {
        allow read: if (isBroker() && request.auth.uid == uid) || canSeeBrokerData();
        allow create, update: if isBroker() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['displayName', 'falNo', 'falExpiry'])
          && request.resource.data.falNo.matches('^[0-9]{8,12}$')
          && request.resource.data.falExpiry.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 80;
        allow delete: if false;
      }

      match /leads/{leadId} {
        allow read: if (isBroker() && resource.data.brokerUid == request.auth.uid) || canSeeBrokerData();
        allow create: if isBroker()
          && request.resource.data.keys().hasOnly(['name', 'phone', 'interest', 'source', 'budgetSar', 'notes',
               'status', 'brokerUid', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'phone', 'interest', 'source', 'status', 'brokerUid', 'createdAt'])
          && request.resource.data.brokerUid == request.auth.uid
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time
          && request.resource.data.phone.matches('^\\+9665[0-9]{8}$')
          && request.resource.data.interest in ['rent', 'buy', 'let_my_property', 'sell_my_property']
          && request.resource.data.source in ['referral', 'walk_in', 'call', 'social', 'other']
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80;
        // Only the status moves (forward, or to lost; never out of won/lost) and the notes change.
        allow update: if isBroker() && resource.data.brokerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes'])
          && request.resource.data.status in leadRank().keys()
          && (request.resource.data.status == resource.data.status
              || (!(resource.data.status in ['won', 'lost'])
                  && (request.resource.data.status == 'lost'
                      || leadRank()[request.resource.data.status] > leadRank()[resource.data.status])))
          && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 500);
        allow delete: if false;
      }

      match /viewings/{viewingId} {
        allow read: if (isBroker() && resource.data.brokerUid == request.auth.uid) || canSeeBrokerData();
        allow create: if isBroker()
          && request.resource.data.keys().hasOnly(['leadId', 'placeLabel', 'scheduledAt', 'notes', 'done',
               'brokerUid', 'createdAt'])
          && request.resource.data.keys().hasAll(['leadId', 'placeLabel', 'scheduledAt', 'done', 'brokerUid', 'createdAt'])
          && request.resource.data.brokerUid == request.auth.uid
          && request.resource.data.done == false
          && request.resource.data.createdAt == request.time
          && leadOf(request.resource.data.leadId).data.brokerUid == request.auth.uid;
        allow update: if isBroker() && resource.data.brokerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
          && request.resource.data.done == true;
        allow delete: if false;
      }

      match /brokerContracts/{contractId} {
        allow read: if (isBroker() && resource.data.brokerUid == request.auth.uid) || canSeeBrokerData();
        allow create: if isBroker()
          && request.resource.data.keys().hasOnly(['leadId', 'type', 'contractNo', 'startDate', 'endDate',
               'commissionPct', 'brokerUid', 'createdAt'])
          && request.resource.data.keys().hasAll(['leadId', 'type', 'contractNo', 'startDate', 'endDate',
               'brokerUid', 'createdAt'])
          && request.resource.data.brokerUid == request.auth.uid
          && request.resource.data.type in ['rent', 'sale', 'management']
          && request.resource.data.endDate > request.resource.data.startDate
          && request.resource.data.createdAt == request.time
          && leadOf(request.resource.data.leadId).data.brokerUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /brokerActivity/{entryId} {
        allow read: if (isBroker() && resource.data.brokerUid == request.auth.uid) || canSeeBrokerData();
        allow create: if isBroker()
          && request.resource.data.keys().hasOnly(['leadId', 'type', 'text', 'brokerUid', 'createdAt'])
          && request.resource.data.brokerUid == request.auth.uid
          && request.resource.data.type in ['lead_created', 'status_changed', 'viewing_scheduled',
               'viewing_done', 'contract_added', 'note']
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time
          && leadOf(request.resource.data.leadId).data.brokerUid == request.auth.uid;
        allow update, delete: if false;
      }

      // In-app reminders are written by Functions; a user reads their own and may mark them read.
      match /notifications/{nid} {
        allow read: if isMember(orgId) && resource.data.uid == request.auth.uid;
        allow update: if isMember(orgId) && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow create, delete: if false;
      }
    }

    // Indicative neighborhood figures imported by an admin (Functions write only). Always "indicative", never a valuation.
    match /insights/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Public site: anonymous "was this page helpful?" answers (no personal data). Create-only;
    // nobody reads them from a client (the team reviews them in the console).
    match /siteFeedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['page', 'helpful', 'reasons', 'comment', 'locale', 'createdAt'])
        && request.resource.data.keys().hasAll(['page', 'helpful', 'reasons', 'comment', 'locale', 'createdAt'])
        && request.resource.data.page is string
        && request.resource.data.page.size() >= 1 && request.resource.data.page.size() <= 120
        && request.resource.data.helpful is bool
        && request.resource.data.reasons is list && request.resource.data.reasons.size() <= 4
        && request.resource.data.reasons.hasOnly(['clear', 'found', 'easy', 'unclear', 'missing', 'technical', 'other'])
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
        && request.resource.data.locale in ['ar', 'en']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Public site: contact messages, sent with explicit consent to reply. Create-only; read in the console.
    match /siteMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'consent', 'locale', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'topic', 'message', 'consent', 'locale', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.topic in ['question', 'problem', 'idea', 'privacy', 'accessibility']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
        && request.resource.data.consent == true
        && request.resource.data.locale in ['ar', 'en']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
