{
  "$comment": "Najd Dusk — single source of truth. Run `pnpm build` in this package to regenerate CSS, Tailwind theme and Dart. Contrast pairs are enforced by scripts/check-contrast.mjs.",
  "color": {
    "night": "#0E0D0B",
    "charcoal": "#1A1815",
    "sand": "#F4EEE4",
    "stone": "#8C8478",
    "stoneInk": "#6A6358",
    "clay": "#B5532C",
    "clayLight": "#D9825A",
    "clayInk": "#9C4522",
    "success": "#4F7A5A",
    "successInk": "#3F6549",
    "successLight": "#6FA37C",
    "white": "#FFFFFF",
    "warning": "#C08A2E",
    "warningInk": "#7A5712",
    "danger": "#A63D32",
    "dangerLight": "#D9695D"
  },
  "theme": {
    "light": {
      "bg": "sand",
      "surface": "#FFFFFF",
      "text": "night",
      "textMuted": "stoneInk",
      "border": "stone",
      "brand": "clay",
      "onBrand": "white",
      "brandText": "clayInk",
      "success": "successInk",
      "warning": "warningInk",
      "danger": "danger"
    },
    "dark": {
      "bg": "night",
      "surface": "charcoal",
      "text": "sand",
      "textMuted": "stone",
      "border": "stone",
      "brand": "clay",
      "onBrand": "white",
      "brandText": "clayLight",
      "success": "successLight",
      "warning": "warning",
      "danger": "dangerLight"
    }
  },
  "contrastPairs": [
    ["text", "bg", 7],
    ["text", "surface", 7],
    ["textMuted", "bg", 4.5],
    ["textMuted", "surface", 4.5],
    ["onBrand", "brand", 4.5],
    ["brandText", "bg", 4.5],
    ["brandText", "surface", 4.5],
    ["success", "bg", 4.5],
    ["warning", "bg", 4.5],
    ["danger", "bg", 4.5]
  ],
  "font": {
    "arDisplay": "Reem Kufi",
    "arBody": "IBM Plex Sans Arabic",
    "latDisplay": "Fraunces",
    "latBody": "IBM Plex Sans"
  },
  "fontSize": {
    "d1": 72,
    "d2": 56,
    "h1": 40,
    "h2": 28,
    "h3": 20,
    "body": 17,
    "small": 15,
    "caption": 13
  },
  "lineHeight": { "arabic": 1.7, "latin": 1.5, "display": 1.15 },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96],
  "radius": { "sm": 4, "md": 8, "lg": 16, "xl": 28 },
  "motion": {
    "easing": [0.16, 1, 0.3, 1],
    "fast": 200,
    "base": 400,
    "slow": 700,
    "camera": 2500
  },
  "borderAlpha": 0.25
}
